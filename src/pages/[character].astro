---
import Layout from '../layouts/Layout.astro';
import { supabase, type Combo } from '../lib/supabase';
import NotationToggle from '../components/NotationToggle.astro';
import { wilsonScore, scoreLabel } from '../lib/wilson';

export const prerender = false;

const { character } = Astro.params;

const { data: combos } = await supabase
  .from('combos')
  .select('*')
  .eq('character', character)
  .order('damage', { ascending: false });

// 投票データを一括取得してコンボごとに集計
const comboIds = (combos ?? []).map((c: Combo) => c.id);
const { data: allVotes } = comboIds.length > 0
  ? await supabase.from('votes').select('combo_id, is_working').in('combo_id', comboIds)
  : { data: [] };

const voteMap = new Map<number, { working: number; total: number }>();
for (const v of allVotes ?? []) {
  const cur = voteMap.get(v.combo_id) ?? { working: 0, total: 0 };
  voteMap.set(v.combo_id, {
    working: cur.working + (v.is_working ? 1 : 0),
    total: cur.total + 1,
  });
}

function getVoteStyle(comboId: number): { label: string; bg: string; color: string } {
  const stats = voteMap.get(comboId) ?? { working: 0, total: 0 };
  const score = wilsonScore(stats.working, stats.total);
  const label = scoreLabel(score, stats.total);
  if (label.includes('高信頼')) return { label, bg: 'rgba(52,211,153,0.12)',  color: '#34d399' };
  if (label.includes('確認中')) return { label, bg: 'rgba(245,158,11,0.12)',  color: '#f59e0b' };
  if (label.includes('要注意')) return { label, bg: 'rgba(239,68,68,0.12)',   color: '#f87171' };
  if (label.includes('データ少')) return { label, bg: 'rgba(251,191,36,0.1)', color: '#fbbf24' };
  return { label, bg: 'rgba(0,0,0,0.04)', color: '#999' };
}

// 分岐パターンを検出してベースコマンドを抽出
function parseInputs(raw: string): { base: string; hasBranch: boolean } {
  if (!raw.includes('分岐')) return { base: raw, hasBranch: false };
  const base = raw
    .replace(/\s*の後に分岐.*$/, '')
    .replace(/\s*（分岐.*）$/, '')
    .replace(/\s*\(分岐.*\)$/, '')
    .trim();
  return { base: base || raw, hasBranch: true };
}

// situation[0] でグループ化（なければ "その他"）
const grouped = new Map<string, Combo[]>();
for (const combo of combos ?? []) {
  const cat = (combo.situation as string[])[0] ?? 'その他';
  if (!grouped.has(cat)) grouped.set(cat, []);
  grouped.get(cat)!.push(combo);
}
const groups = [...grouped.entries()];

const COLORS = [
  { bg: 'rgba(245,166,35,0.1)',  text: '#f5a623' },
  { bg: 'rgba(230,57,70,0.1)',   text: '#f87171' },
  { bg: 'rgba(79,195,247,0.1)',  text: '#4fc3f7' },
  { bg: 'rgba(167,243,208,0.08)',text: '#6ee7b7' },
  { bg: 'rgba(196,181,253,0.08)',text: '#c4b5fd' },
  { bg: 'rgba(249,115,22,0.08)', text: '#fb923c' },
  { bg: 'rgba(253,224,71,0.08)', text: '#fde047' },
  { bg: 'rgba(56,189,248,0.08)', text: '#38bdf8' },
];
function getColor(name: string) {
  return COLORS[(name ?? '').charCodeAt(0) % COLORS.length];
}
const charColor = getColor(character ?? '');
---

<Layout title={`${character} コンボ一覧 | SF6 Combo Archive`} character={character ?? ''}>
  <!-- パンくず -->
  <div class="breadcrumb">
    <a href="/">← キャラクター一覧</a>
  </div>

  <!-- キャラクターヘッダー -->
  <div style="display:flex; align-items:flex-end; justify-content:space-between; margin-bottom:28px; border-bottom:1px solid rgba(245,166,35,0.25); padding-bottom:16px;">
    <div style="display:flex; align-items:center; gap:16px;">
      <div style={`background:${charColor.bg}; color:${charColor.text}; width:52px; height:52px; font-size:1.8rem; display:flex; align-items:center; justify-content:center; border-radius:8px; font-weight:700; font-family:'JetBrains Mono',monospace;`}>
        {(character ?? '').charAt(0).toUpperCase()}
      </div>
      <h1 style="font-size:2rem; font-weight:700; color:var(--text); margin:0;">
        {character}
      </h1>
    </div>
    <span style="color:var(--muted); font-size:0.82rem;">
      {groups.length}分類 · {combos?.length ?? 0}コンボ
    </span>
  </div>

  <!-- 表記トグル -->
  <NotationToggle />

  <!-- 列表示トグル -->
  <div style="display:flex; align-items:center; gap:6px; flex-wrap:wrap; margin:10px 0 14px;">
    <span class="section-label" style="margin:0; margin-right:4px;">表示列</span>
    <button class="chip chip-on" id="tog-situation" data-col-toggle="situation">状況</button>
    <button class="chip chip-on" id="tog-damage"    data-col-toggle="damage"   >ダメージ</button>
    <button class="chip chip-on" id="tog-ender"     data-col-toggle="ender"    >〆分類</button>
    <button class="chip chip-on" id="tog-comment"   data-col-toggle="comment"  >コメント</button>
    <button class="chip chip-on" id="tog-poster"    data-col-toggle="poster"   >投稿者</button>
  </div>

  <!-- テーブルヘッダー -->
  <div class="cc-row cc-head">
    <div class="cc-cell">タイトル</div>
    <div class="cc-cell">コマンド</div>
    <div class="cc-cell" data-col="situation">状況</div>
    <div class="cc-cell cc-num" data-col="damage">ダメージ</div>
    <div class="cc-cell" data-col="ender">〆分類</div>
    <div class="cc-cell" data-col="comment">コメント</div>
    <div class="cc-cell" data-col="poster">投稿者</div>
  </div>

  <!-- カテゴリ別グループ -->
  {groups.map(([category, categoryComobos], groupIdx) => (
    <div>
      <div class="cc-cat-header" onclick={`toggleCat('cc-body-${groupIdx}')`}>
        <span>{category}</span>
        <span style="display:flex; align-items:center; gap:8px;">
          <span style="font-size:0.75rem; color:#888;">{categoryComobos.length}件</span>
          <span class="cc-chevron" id={`cc-chev-${groupIdx}`}>▾</span>
        </span>
      </div>

      <div id={`cc-body-${groupIdx}`} class="cc-group-body">
        {categoryComobos.map((combo: Combo) => {
          const { base, hasBranch } = parseInputs(combo.inputs);
          const vote = getVoteStyle(combo.id);
          const subSituations = (combo.situation as string[]).slice(1);

          return (
            <a href={`/combo/${combo.id}`} class="cc-row cc-data-row">
              <!-- タイトル（狭め） -->
              <div class="cc-cell cc-cell-title">
                <span class="cc-title-text">{combo.title || '—'}</span>
              </div>

              <!-- コマンド（柔軟幅） -->
              <div class="cc-cell cc-cell-cmd">
                <div style="display:flex; align-items:center; gap:6px; flex-wrap:wrap; min-width:0; margin-bottom:4px;">
                  <span class="notation notation-sm" data-original={base}>{base}</span>
                  {hasBranch && (
                    <span class="tag" style="background:rgba(196,181,253,0.15); color:#a78bfa; flex-shrink:0;">分岐有り</span>
                  )}
                </div>
                <div style="display:flex; gap:4px; flex-wrap:wrap;">
                  <span class="tag" style={`background:${vote.bg}; color:${vote.color};`}>{vote.label}</span>
                  {combo.gauge > 0 && (
                    <span class="tag" style="background:rgba(239,68,68,0.1); color:#f87171;">ゲージ {combo.gauge}</span>
                  )}
                  {combo.youtube_id
                    ? <span class="tag" style="background:rgba(79,195,247,0.1); color:#4fc3f7;">動画あり</span>
                    : <span class="tag" style="background:rgba(0,0,0,0.04); color:#aaa;">動画なし</span>
                  }
                </div>
              </div>

              <!-- 状況 -->
              <div class="cc-cell cc-cell-situation" data-col="situation">
                {subSituations.length > 0
                  ? <div style="display:flex; gap:3px; flex-wrap:wrap;">
                      {subSituations.map((s: string) => (
                        <span class="tag" style="background:rgba(245,166,35,0.1); color:#c97a00;">{s}</span>
                      ))}
                    </div>
                  : <span style="color:#ccc;">—</span>
                }
              </div>

              <!-- ダメージ -->
              <div class="cc-cell cc-num" data-col="damage">
                <span style="font-weight:700; font-size:0.98rem; font-family:'JetBrains Mono',monospace; font-variant-numeric:tabular-nums;">
                  {combo.damage > 0 ? combo.damage.toLocaleString() : '—'}
                </span>
              </div>

              <!-- 〆分類 -->
              <div class="cc-cell" data-col="ender">
                {combo.ender_class
                  ? <span class="tag">{combo.ender_class}</span>
                  : <span style="color:#ccc;">—</span>
                }
              </div>

              <!-- コメント -->
              <div class="cc-cell cc-cell-comment" data-col="comment">
                <span style="font-size:0.82rem; color:var(--text-soft); line-height:1.4;">
                  {combo.comment ?? ''}
                </span>
              </div>

              <!-- 投稿者 -->
              <div class="cc-cell" data-col="poster">
                <span style="font-size:0.82rem; color:var(--muted);">
                  {combo.poster ?? '—'}
                </span>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  ))}
</Layout>

<style is:global>
  /* ── コンボテーブル グリッドレイアウト ── */
  :root {
    --cc-title-w: 110px;
    --combo-cols: var(--cc-title-w) 1fr 82px 70px 96px 140px 74px;
  }

  .cc-row {
    display: grid;
    grid-template-columns: var(--combo-cols);
    align-items: stretch;
  }

  /* テーブルヘッダー */
  .cc-head {
    border-top: 2px solid var(--border-strong);
    border-bottom: 1px solid var(--border-strong);
    background: var(--surface2);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted-strong);
  }
  .cc-head .cc-cell {
    padding: 7px 10px;
    display: flex;
    align-items: center;
  }

  /* データ行 */
  .cc-data-row {
    border-bottom: 1px solid var(--border);
    text-decoration: none;
    color: var(--text);
    transition: background 0.1s;
  }
  .cc-data-row:last-child { border-bottom: none; }
  .cc-data-row:hover { background: var(--surface); }

  /* セル共通 */
  .cc-cell {
    padding: 9px 10px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
  }

  /* 数値列（右寄せ） */
  .cc-num {
    align-items: flex-end;
  }

  /* タイトルセル */
  .cc-cell-title {
    border-right: 1px solid var(--border);
  }
  .cc-title-text {
    font-size: 0.78rem;
    color: var(--text-soft);
    line-height: 1.35;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* コマンドセル */
  .cc-cell-cmd .notation {
    max-width: 100%;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    flex-wrap: nowrap;
  }

  /* カテゴリヘッダー */
  .cc-cat-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 7px 12px;
    background: var(--surface2);
    border-bottom: 1px solid var(--border);
    cursor: pointer;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--muted-strong);
    user-select: none;
    border-top: 1px solid var(--border);
    margin-top: 4px;
  }
  .cc-cat-header:hover { background: var(--surface3); }

  .cc-chevron { transition: transform 0.18s; display:inline-block; }
  .cc-chevron.closed { transform: rotate(-90deg); }

  /* グループボディ */
  .cc-group-body {
    border: 1px solid var(--border);
    border-top: none;
    background: #fff;
    overflow: hidden;
    border-radius: 0 0 4px 4px;
  }
  .cc-group-body.collapsed { display: none; }
</style>

<script>
  const COL_WIDTHS: Record<string, string> = {
    situation: '82px',
    damage:    '70px',
    ender:     '96px',
    comment:   '140px',
    poster:    '74px',
  };
  const ALL_COLS = Object.keys(COL_WIDTHS) as (keyof typeof COL_WIDTHS)[];

  // localStorage から非表示列セットを復元
  let hidden: Set<string>;
  try {
    const saved = localStorage.getItem('sf6-combo-hidden-cols');
    hidden = saved ? new Set(JSON.parse(saved)) : new Set<string>();
  } catch {
    hidden = new Set<string>();
  }

  function applyLayout() {
    const parts = ['110px', '1fr'];
    for (const col of ALL_COLS) {
      if (!hidden.has(col)) parts.push(COL_WIDTHS[col]);
    }
    document.documentElement.style.setProperty('--combo-cols', parts.join(' '));

    for (const col of ALL_COLS) {
      const visible = !hidden.has(col);
      document.querySelectorAll(`[data-col="${col}"]`).forEach(el => {
        (el as HTMLElement).style.display = visible ? '' : 'none';
      });
      const btn = document.getElementById(`tog-${col}`);
      if (btn) btn.classList.toggle('chip-on', visible);
    }

    localStorage.setItem('sf6-combo-hidden-cols', JSON.stringify([...hidden]));
  }

  for (const col of ALL_COLS) {
    document.getElementById(`tog-${col}`)?.addEventListener('click', () => {
      if (hidden.has(col)) hidden.delete(col);
      else hidden.add(col);
      applyLayout();
    });
  }

  applyLayout();

  function toggleCat(bodyId: string) {
    const body = document.getElementById(bodyId);
    if (!body) return;
    const idx = bodyId.replace('cc-body-', '');
    body.classList.toggle('collapsed');
    document.getElementById(`cc-chev-${idx}`)?.classList.toggle('closed');
  }
  (window as any).toggleCat = toggleCat;
</script>
