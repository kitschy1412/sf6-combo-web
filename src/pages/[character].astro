---
import { supabase, type Combo } from '../lib/supabase';

export const prerender = false;

const { character } = Astro.params;

const { data: combos } = await supabase
  .from('combos')
  .select('*')
  .eq('character', character)
  .order('damage', { ascending: false });
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{character} コンボ一覧 | SF6 Combo Archive</title>
    <style>
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body { font-family: sans-serif; background: #0f0f0f; color: #eee; }
      header { padding: 1.5rem 2rem; border-bottom: 1px solid #333; display: flex; align-items: center; gap: 1rem; }
      header a { color: #f5a623; text-decoration: none; font-size: 0.9rem; }
      header h1 { font-size: 1.5rem; }
      main { max-width: 960px; margin: 0 auto; padding: 2rem; }
      .list { display: flex; flex-direction: column; gap: 1rem; }
      a.card {
        display: block; padding: 1.2rem; background: #1a1a1a;
        border: 1px solid #333; border-radius: 8px;
        text-decoration: none; color: #eee; transition: border-color 0.2s;
      }
      a.card:hover { border-color: #f5a623; }
      .card-title { font-size: 1rem; font-weight: bold; margin-bottom: 0.5rem; }
      .card-inputs { font-size: 0.85rem; color: #aaa; font-family: monospace; margin-bottom: 0.5rem; }
      .card-meta { display: flex; gap: 1rem; font-size: 0.8rem; color: #888; flex-wrap: wrap; }
      .tag {
        padding: 0.2rem 0.5rem; border-radius: 4px;
        background: #2a2a2a; font-size: 0.75rem;
      }
      .damage { color: #f5a623; font-weight: bold; }
    </style>
  </head>
  <body>
    <header>
      <a href="/">← 一覧に戻る</a>
      <h1>{character} のコンボ（{combos?.length ?? 0}件）</h1>
    </header>
    <main>
      <div class="list">
        {(combos ?? []).map((combo: Combo) => (
          <a class="card" href={`/combo/${combo.id}`}>
            <div class="card-title">{combo.title}</div>
            <div class="card-inputs">{combo.inputs}</div>
            <div class="card-meta">
              <span class="damage">ダメージ: {combo.damage}</span>
              <span>ゲージ: {combo.gauge}</span>
              <span>ver {combo.patch_version}</span>
              {combo.situation.map((s: string) => (
                <span class="tag">{s}</span>
              ))}
            </div>
          </a>
        ))}
      </div>
    </main>
  </body>
</html>
