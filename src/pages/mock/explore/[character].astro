---
import Layout from '../../../layouts/Layout.astro';
import Notation from '../../../components/Notation.astro';
import NotationToggle from '../../../components/NotationToggle.astro';
import { wilsonScore, scoreLabel } from '../../../lib/wilson';
import {
  COMBOS, ENDER_CLASSES, KNOCKDOWN_SITUATIONS,
  getEnderClassById, getComboRoutes, hasBranches, getComboBrokenCount,
  getOkizemeByEnderClass,
} from '../../../mock-data/rashid';

const { character } = Astro.params;
const charName = character === 'rashid' ? 'Rashid' : (character ?? '');

// 公開コンボのみ（private は除外）
const publicCombos = COMBOS.filter(c => c.visibility !== 'private');

const majorVals = [...new Set(publicCombos.map(c => c.categoryMajor).filter(Boolean))] as string[];
const minorsByMajor: Record<string, string[]> = {};
for (const c of publicCombos) {
  if (!c.categoryMajor) continue;
  const list = (minorsByMajor[c.categoryMajor] ??= []);
  if (c.categoryMinor && !list.includes(c.categoryMinor)) list.push(c.categoryMinor);
}

// ソート用メタ情報（サーバー側で計算 → data 属性として埋め込む）
const sortMeta: Record<string, { score: number; damage: number; order: number }> = {};
publicCombos.forEach((c, idx) => {
  const routes = getComboRoutes(c);
  const maxDamage = Math.max(0, ...routes.map(r => r.leaf.damage ?? 0));
  const allVotes = routes.map(r => r.leaf.votes).filter(Boolean);
  const bestScore = allVotes.length > 0
    ? Math.max(...allVotes.map(v => wilsonScore(v!.good, v!.good + v!.bad)))
    : 0;
  sortMeta[c.id] = { score: Math.round(bestScore * 1000), damage: maxDamage, order: idx };
});

// 2段階グループ: 大分類 → 小分類[] → コンボ[]
type MinorGroup = { minor: string; items: typeof publicCombos };
type MajorGroup = { major: string; total: number; minors: MinorGroup[] };
const majorGroups: MajorGroup[] = [];
for (const c of publicCombos) {
  const major = c.categoryMajor ?? '';
  const minor = c.categoryMinor ?? '';
  let mg = majorGroups.find(g => g.major === major);
  if (!mg) { mg = { major, total: 0, minors: [] }; majorGroups.push(mg); }
  let ming = mg.minors.find(m => m.minor === minor);
  if (!ming) { ming = { minor, items: [] }; mg.minors.push(ming); }
  ming.items.push(c);
  mg.total++;
}

function getComboScoreLabel(c: (typeof publicCombos)[0]): string {
  const routes = getComboRoutes(c);
  const allVotes = routes.map(r => r.leaf.votes).filter(Boolean);
  if (allVotes.length === 0) return '❓ 未検証';
  const bestTotal = Math.max(...allVotes.map(v => v!.good + v!.bad));
  if (bestTotal === 0) return '❓ 未検証';
  const bestScore = Math.max(...allVotes.map(v => wilsonScore(v!.good, v!.good + v!.bad)));
  return scoreLabel(bestScore, bestTotal);
}
---

<Layout title={`${charName} — 公開コンボ一覧`}>
  <nav class="breadcrumb">
    <a href="/mock/">モックトップ</a>
    <span class="sep">/</span>
    <a href="/mock/explore/">公開コンボ</a>
    <span class="sep">/</span>
    <span style="color:var(--text);">{charName}</span>
  </nav>

  <div class="page-head" style="border-radius:6px 6px 0 0;">
    <div style="display:flex; gap:14px; align-items:baseline;">
      <h1>{charName.toUpperCase()}</h1>
      <span class="meta">v1.25 ・ {publicCombos.length}コンボ ・ {ENDER_CLASSES.length}分類</span>
    </div>
    <div style="display:flex; gap:8px; align-items:center;">
      <span style="font-size:0.72rem; color:rgba(255,255,255,0.45);">読み取り専用</span>
      <a href={`/mock/character/${character}`} class="btn btn-sm" style="background:transparent; color:#fff; border-color:#555;">
        自分用ページへ →
      </a>
    </div>
  </div>

  <div class="filter-bar filter-bar-row" style="border-radius:0 0 6px 6px; border-top:none; margin-bottom:24px;">
    <span class="filter-label">並び順</span>
    <div class="sort-toggle-group" role="group">
      <button type="button" class="sort-btn sort-btn-active" data-sort="score">投票スコア順</button>
      <button type="button" class="sort-btn" data-sort="damage">ダメージ降順</button>
      <button type="button" class="sort-btn" data-sort="new">新着順</button>
    </div>

    <span class="filter-divider" aria-hidden="true"></span>

    <span class="filter-label">分類</span>
    <select id="filter-major" class="select select-inline">
      <option value="">大分類すべて</option>
      {majorVals.map(m => <option value={m}>{m}</option>)}
    </select>
    <select id="filter-minor" class="select select-inline">
      <option value="">小分類すべて</option>
      {Object.entries(minorsByMajor).flatMap(([maj, minors]) =>
        minors.map(min => <option value={min} data-major={maj}>{min}</option>)
      )}
    </select>
  </div>

  <section style="margin-bottom:32px;">
    <div class="section-head">
      <h2>コンボ</h2>
    </div>

    <NotationToggle character={charName} />

    <table class="data-table" id="combo-table">
      <colgroup>
        <col style="width:180px;" />
        <col />
        <col style="width:128px;" />
        <col style="width:104px;" />
        <col style="width:120px;" />
        <col style="width:64px;" />
        <col style="width:88px;" />
      </colgroup>
      {majorGroups.map(({ major, total, minors }) => (
        <>
          <tbody class="combo-major-head" data-head-major={major}>
            <tr>
              <td colspan="7" class="combo-major-cell">
                <div class="combo-major-inner">
                  <span class="combo-major-title">{major || '未分類'}</span>
                  <span class="combo-major-count">{total}コンボ</span>
                </div>
              </td>
            </tr>
          </tbody>

          <tbody class="combo-col-head" data-head-major={major}>
            <tr>
              <th>タイトル</th>
              <th>コマンド</th>
              <th>状況</th>
              <th>投稿者</th>
              <th>〆分類</th>
              <th class="col-num">ダメージ</th>
              <th class="col-num">スコア</th>
            </tr>
          </tbody>

          {minors.map(({ minor, items }) => (
            <>
              <tbody class="combo-section-head" data-head-major={major} data-head-minor={minor}>
                <tr>
                  <td colspan="7" class="combo-minor-cell">
                    <div class="combo-minor-inner">
                      <span class="combo-minor-title">{minor || '未分類'}</span>
                      <span class="combo-minor-rule" />
                      <span class="combo-minor-count">{items.length}件</span>
                    </div>
                  </td>
                </tr>
              </tbody>

              {items.map((c) => {
                const routes = getComboRoutes(c);
                const branched = hasBranches(c);
                const broken = getComboBrokenCount(c);
                const meta = sortMeta[c.id];
                return (
                  <tbody class="combo-group"
                    data-combo-id={c.id}
                    data-source={c.sourceType}
                    data-major={c.categoryMajor ?? ''}
                    data-minor={c.categoryMinor ?? ''}
                    data-sort-score={meta.score}
                    data-sort-damage={meta.damage}
                    data-sort-order={meta.order}
                  >
                    {!branched && (() => {
                      const r = routes[0];
                      const ender = r.leaf.enderClassId ? getEnderClassById(r.leaf.enderClassId) : null;
                      const okizemeList = r.leaf.enderClassId ? getOkizemeByEnderClass(r.leaf.enderClassId) : [];
                      return (
                        <>
                          <tr>
                            <td>
                              <div class="title-cell">
                                <a href={`/mock/combo/${c.id}`} class="col-title">{c.title}</a>
                                <button type="button" class="btn-fork" data-combo-id={c.id}>⑂ fork</button>
                              </div>
                            </td>
                            <td><Notation inputs={r.fullInputs} size="sm" /></td>
                            <td>{(r.leaf.situationTags ?? []).map(t => <span class="tag" style="margin-right:3px;">{t}</span>)}</td>
                            <td class="col-poster">
                              {c.sourceType === 'personal' && <span class="tag tag-personal">自分のメモ</span>}
                              {c.sourceType === 'shared' && <span class="poster-name">{c.ownerLabel}</span>}
                              {c.sourceType === 'forked' && <><span class="tag">fork</span><span class="poster-name">{c.ownerLabel}</span></>}
                              {c.visibility === 'unlisted' && <span class="tag tag-unlisted">🔗</span>}
                            </td>
                            <td class="col-ender">
                              <span title={ender?.displayName}>{ender ? ender.displayName : '—'}</span>
                              {okizemeList.length > 0 && (
                                <button type="button" class="okizeme-toggle" data-okizeme-toggle={r.leaf.id}
                                  title={`起き攻め ${okizemeList.length}件を展開`}>
                                  起き攻め{okizemeList.length}件
                                </button>
                              )}
                            </td>
                            <td class="col-num"><span class="dmg">{(r.leaf.damage ?? 0).toLocaleString()}</span></td>
                            <td class="col-score">
                              <span class="score-label-badge">{getComboScoreLabel(c)}</span>
                              {broken > 0 && <span class="tag tag-warn score-warn">⚠ 不可{broken}</span>}
                            </td>
                          </tr>
                          {okizemeList.length > 0 && (
                            <tr class="okizeme-panel-row" data-okizeme-panel={r.leaf.id} style="display:none;">
                              <td colspan="7" class="okizeme-panel-cell">
                                <div class="okizeme-panel">
                                  <div class="okizeme-panel-hd">
                                    <span class="okizeme-panel-count">起き攻め {okizemeList.length}件</span>
                                    {ender && <span class="okizeme-panel-ender">{ender.displayName}{ender.frameAdvantage ? ` / ${ender.frameAdvantage}` : ''}</span>}
                                  </div>
                                  <div class="okizeme-cards">
                                    {okizemeList.map(o => (
                                      <div class="okizeme-card">
                                        <div class="okizeme-card-hd">
                                          <span class="okizeme-card-title">{o.title}</span>
                                          <span class="okizeme-card-flags">
                                            {o.flags.mid && <span class="okizeme-flag">中段</span>}
                                            {o.flags.low && <span class="okizeme-flag">下段</span>}
                                            {o.flags.throw && <span class="okizeme-flag">投げ</span>}
                                            {o.flags.safeJump && <span class="okizeme-flag okizeme-flag-safe">詐欺</span>}
                                          </span>
                                        </div>
                                        <div class="okizeme-card-inputs"><Notation inputs={o.inputs} size="sm" /></div>
                                        <div class="okizeme-card-wk">
                                          {o.vsWakeup.guard && <div><span class="wk-label">GD</span>{' '}{o.vsWakeup.guard}</div>}
                                          {o.vsWakeup.mash && <div><span class="wk-label">暴れ</span>{' '}{o.vsWakeup.mash}</div>}
                                          {o.vsWakeup.invincible && <div><span class="wk-label">無敵</span>{' '}{o.vsWakeup.invincible}</div>}
                                        </div>
                                      </div>
                                    ))}
                                  </div>
                                </div>
                              </td>
                            </tr>
                          )}
                        </>
                      );
                    })()}

                    {branched && (
                      <>
                        <tr class="combo-parent-row">
                          <td>
                            <div class="title-cell">
                              <a href={`/mock/combo/${c.id}`} class="col-title">{c.title}</a>
                              <button type="button" class="branch-toggle" data-combo-id={c.id} title="分岐ルートを展開/折り畳み">
                                <span class="branch-toggle-icon">▶</span>
                                <span class="tag" style="background:#111; color:#fff; font-size:0.66rem;">{routes.length}ルート</span>
                              </button>
                              <button type="button" class="btn-fork" data-combo-id={c.id}>⑂ fork</button>
                            </div>
                          </td>
                          <td colspan="2" style="color:var(--muted); font-size:0.82rem;">
                            <Notation inputs={c.root.segment} size="sm" />
                            <span style="margin-left:8px; color:var(--muted);">…の後に分岐</span>
                          </td>
                          <td class="col-poster">
                            {c.sourceType === 'personal' && <span class="tag tag-personal">自分のメモ</span>}
                            {c.sourceType === 'shared' && <span class="poster-name">{c.ownerLabel}</span>}
                            {c.sourceType === 'forked' && <><span class="tag">fork</span><span class="poster-name">{c.ownerLabel}</span></>}
                            {c.visibility === 'unlisted' && <span class="tag tag-unlisted">🔗</span>}
                          </td>
                          <td></td>
                          <td></td>
                          <td class="col-score">
                            <span class="score-label-badge">{getComboScoreLabel(c)}</span>
                          </td>
                        </tr>
                        {routes.map((r, ri) => {
                          const ender = r.leaf.enderClassId ? getEnderClassById(r.leaf.enderClassId) : null;
                          const tailInputs = r.pathSegments[r.pathSegments.length - 1];
                          const ghostInputs = r.pathSegments.slice(0, -1).join(' > ');
                          const isLastRoute = ri === routes.length - 1;
                          const okizemeList = r.leaf.enderClassId ? getOkizemeByEnderClass(r.leaf.enderClassId) : [];
                          const routeVotes = r.leaf.votes;
                          const routeTotal = routeVotes ? routeVotes.good + routeVotes.bad : 0;
                          const routeScore = routeVotes ? wilsonScore(routeVotes.good, routeTotal) : 0;
                          return (
                            <>
                              <tr class="combo-child-row" data-branch-of={c.id} style="display:none;">
                                <td style="padding-left:24px; color:var(--muted-strong); font-size:0.85rem;">
                                  <span style="color:var(--muted); font-family:'JetBrains Mono',monospace;">{isLastRoute ? '└─' : '├─'}</span>
                                  {' '}
                                  <a href={`/mock/combo/${c.id}#${r.leaf.id}`} class="row-link" style="display:inline; color:var(--text);">
                                    {r.leaf.routeLabel ?? '(無名ルート)'}
                                  </a>
                                </td>
                                <td><Notation inputs={tailInputs} ghostInputs={ghostInputs} branchElbow={isLastRoute ? '└─›' : '├─›'} size="sm" /></td>
                                <td>{(r.leaf.situationTags ?? []).map(t => <span class="tag" style="margin-right:3px;">{t}</span>)}</td>
                                <td></td>
                                <td class="col-ender">
                                  <span title={ender?.displayName}>{ender ? ender.displayName : '—'}</span>
                                  {okizemeList.length > 0 && (
                                    <button type="button" class="okizeme-toggle" data-okizeme-toggle={r.leaf.id}
                                      title={`起き攻め ${okizemeList.length}件を展開`}>
                                      <span class="okizeme-toggle-icon">◇</span>{okizemeList.length}
                                    </button>
                                  )}
                                </td>
                                <td class="col-num"><span class="dmg">{(r.leaf.damage ?? 0).toLocaleString()}</span></td>
                                <td class="col-score">
                                  <span class="score-label-badge score-label-sm">{scoreLabel(routeScore, routeTotal)}</span>
                                  {(r.leaf.votes?.brokenInCurrentVer ?? 0) > 0 && <span class="tag tag-warn score-warn">⚠ {r.leaf.votes!.brokenInCurrentVer}</span>}
                                </td>
                              </tr>
                              {okizemeList.length > 0 && (
                                <tr class="okizeme-panel-row" data-okizeme-panel={r.leaf.id} data-okizeme-branch-of={c.id} style="display:none;">
                                  <td colspan="7" class="okizeme-panel-cell">
                                    <div class="okizeme-panel">
                                      <div class="okizeme-panel-hd">
                                        <span class="okizeme-panel-count">起き攻め {okizemeList.length}件</span>
                                        {ender && <span class="okizeme-panel-ender">{ender.displayName}{ender.frameAdvantage ? ` / ${ender.frameAdvantage}` : ''}</span>}
                                      </div>
                                      <div class="okizeme-cards">
                                        {okizemeList.map(o => (
                                          <div class="okizeme-card">
                                            <div class="okizeme-card-hd">
                                              <span class="okizeme-card-title">{o.title}</span>
                                              <span class="okizeme-card-flags">
                                                {o.flags.mid && <span class="okizeme-flag">中段</span>}
                                                {o.flags.low && <span class="okizeme-flag">下段</span>}
                                                {o.flags.throw && <span class="okizeme-flag">投げ</span>}
                                                {o.flags.safeJump && <span class="okizeme-flag okizeme-flag-safe">詐欺</span>}
                                              </span>
                                            </div>
                                            <div class="okizeme-card-inputs"><Notation inputs={o.inputs} size="sm" /></div>
                                            <div class="okizeme-card-wk">
                                              {o.vsWakeup.guard && <div><span class="wk-label">GD</span>{' '}{o.vsWakeup.guard}</div>}
                                              {o.vsWakeup.mash && <div><span class="wk-label">暴れ</span>{' '}{o.vsWakeup.mash}</div>}
                                              {o.vsWakeup.invincible && <div><span class="wk-label">無敵</span>{' '}{o.vsWakeup.invincible}</div>}
                                            </div>
                                          </div>
                                        ))}
                                      </div>
                                    </div>
                                  </td>
                                </tr>
                              )}
                            </>
                          );
                        })}
                      </>
                    )}
                  </tbody>
                );
              })}
            </>
          ))}
        </>
      ))}
    </table>
  </section>

  <section style="margin-bottom:32px;">
    <div class="section-head">
      <h2>〆分類（起き攻めのカテゴリ）</h2>
    </div>
    <div style="display:grid; grid-template-columns:repeat(auto-fill,minmax(220px,1fr)); gap:10px;">
      {ENDER_CLASSES.map(ec => (
        <div class="card">
          <div style="font-weight:700; margin-bottom:4px;">{ec.displayName}</div>
          <div style="font-size:0.78rem; color:var(--muted);">
            <span class="dmg" style="color:var(--text); font-size:0.85rem;">{ec.frameAdvantage}</span>
            <span style="margin:0 6px; color:var(--border-strong);">|</span>
            コンボ {ec.comboCount} ・ 起き攻め {ec.okizemeCount}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section>
    <div class="section-head">
      <h2>ダウン状況</h2>
    </div>
    <table class="data-table">
      <thead>
        <tr>
          <th>状況</th>
          <th>〆分類</th>
          <th>備考</th>
        </tr>
      </thead>
      <tbody>
        {KNOCKDOWN_SITUATIONS.map(s => (
          <tr>
            <td><a href={`/mock/situation/${s.id}`} class="row-link col-title">{s.label}</a></td>
            <td><span class="tag">{getEnderClassById(s.enderClassId)?.displayName}</span></td>
            <td style="color:var(--muted); font-size:0.82rem;">{s.notes ?? ''}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>

  <style>
    /* ── 列名行 ── */
    .combo-col-head th {
      font-size: 0.7rem;
      font-weight: 600;
      color: var(--muted);
      letter-spacing: 0.04em;
      text-align: left;
      padding: 6px 8px;
      background: transparent;
      border-bottom: 1px solid var(--border);
    }
    .combo-col-head th.col-num { text-align: right; padding-right: 10px; }

    /* ── フィルタバー ── */
    .filter-bar-row {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 8px;
      row-gap: 6px;
    }
    .filter-divider {
      width: 1px;
      height: 18px;
      background: var(--border-strong);
      margin: 0 4px;
    }
    .select-inline {
      height: 26px;
      padding: 2px 8px;
      font-size: 0.8rem;
      width: auto;
      min-width: 132px;
    }

    /* ── ソートトグル ── */
    .sort-toggle-group {
      display: inline-flex;
      border: 1px solid var(--border-strong);
      border-radius: 5px;
      overflow: hidden;
    }
    .sort-btn {
      background: transparent;
      border: none;
      border-right: 1px solid var(--border-strong);
      padding: 3px 10px;
      font-size: 0.76rem;
      font-family: inherit;
      color: var(--muted-strong);
      cursor: pointer;
      transition: background 0.1s, color 0.1s;
      white-space: nowrap;
    }
    .sort-btn:last-child { border-right: none; }
    .sort-btn:hover { background: var(--surface3); color: var(--text); }
    .sort-btn.sort-btn-active {
      background: #111;
      color: #fff;
    }

    /* ── タイトルセル（fork ボタンと横並び） ── */
    .title-cell {
      display: flex;
      align-items: baseline;
      gap: 6px;
      flex-wrap: wrap;
    }
    .col-title {
      font-size: 0.8rem;
      font-weight: 600;
      line-height: 1.35;
      color: inherit;
      text-decoration: none;
      word-break: break-word;
    }
    .col-title:hover { text-decoration: underline; }

    /* ── fork ボタン ── */
    .btn-fork {
      display: inline-flex;
      align-items: center;
      background: transparent;
      border: 1px solid var(--border-strong);
      border-radius: 4px;
      padding: 1px 7px;
      font-size: 0.65rem;
      font-family: inherit;
      color: var(--muted);
      cursor: pointer;
      white-space: nowrap;
      transition: background 0.1s, color 0.1s, border-color 0.1s;
      line-height: 1.6;
      flex-shrink: 0;
      opacity: 0;
      pointer-events: none;
    }
    .combo-group:hover .btn-fork {
      opacity: 1;
      pointer-events: auto;
    }
    .btn-fork:hover {
      background: #111;
      color: #fff;
      border-color: #111;
    }

    /* ── スコア列 ── */
    .col-score {
      font-size: 0.7rem;
      padding-right: 8px !important;
      vertical-align: middle;
    }
    .score-label-badge {
      display: inline-block;
      font-size: 0.68rem;
      white-space: nowrap;
    }
    .score-label-sm { font-size: 0.62rem; }
    .score-warn {
      display: block;
      margin-top: 2px;
      font-size: 0.62rem;
    }

    /* ── 大分類ヘッダー ── */
    .combo-major-cell {
      padding: 0 !important;
      border-bottom: none !important;
      background: transparent !important;
    }
    .combo-major-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 14px 16px 14px 14px;
      margin-top: 20px;
      border-left: 4px solid #f59e0b;
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
      background: var(--surface);
    }
    .combo-major-head:first-of-type .combo-major-inner { margin-top: 0; }
    .combo-major-title {
      font-size: 1rem;
      font-weight: 700;
      letter-spacing: 0.02em;
      color: var(--text);
    }
    .combo-major-count {
      font-size: 0.76rem;
      color: var(--muted);
      font-weight: 600;
      letter-spacing: 0.04em;
    }

    /* ── 小分類サブヘッダー ── */
    .combo-minor-cell {
      padding: 0 !important;
      border-bottom: none !important;
      background: transparent !important;
    }
    .combo-minor-inner {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 7px 16px 7px 22px;
      margin-top: 6px;
      background: var(--surface2);
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border-strong);
      position: relative;
    }
    .combo-minor-inner::before {
      content: '';
      position: absolute;
      left: 14px;
      top: 50%;
      transform: translateY(-50%);
      width: 3px;
      height: 14px;
      background: var(--muted);
      border-radius: 2px;
    }
    .combo-minor-title {
      font-size: 0.84rem;
      font-weight: 700;
      color: var(--text-soft);
      letter-spacing: 0.03em;
      white-space: nowrap;
    }
    .combo-minor-rule { display: none; }
    .combo-minor-count {
      font-size: 0.72rem;
      color: var(--muted);
      font-weight: 600;
      white-space: nowrap;
    }

    /* ── テーブル共通 ── */
    #combo-table { table-layout: fixed; }
    #combo-table th,
    #combo-table td { padding-left: 8px; padding-right: 8px; }
    #combo-table th { font-size: 0.7rem; }
    #combo-table .col-num { font-size: 0.85rem; padding-right: 10px; }
    #combo-table .col-num .dmg { font-size: 0.88rem; }
    #combo-table td .tag { font-size: 0.68rem; padding: 1px 6px; }

    .col-poster {
      font-size: 0.74rem;
      color: var(--muted);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .col-poster .tag { vertical-align: middle; font-size: 0.68rem; padding: 1px 6px; }
    .col-poster .poster-name { margin-left: 4px; vertical-align: middle; }

    .col-ender {
      font-size: 0.76rem;
      color: var(--muted-strong);
      white-space: normal;
    }

    .combo-group tr:not(.insert-here-row) td:first-child {
      border-left: 2px solid transparent;
    }
    .combo-group:hover tr:not(.insert-here-row) td:first-child {
      border-left-color: var(--border-strong);
    }

    .combo-parent-row td { background: var(--surface); font-weight: 600; }
    .combo-parent-row td a { color: var(--text); }
    .combo-child-row td { background: #fff; }

    /* ── 分岐トグルボタン ── */
    .branch-toggle {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      background: transparent;
      border: none;
      cursor: pointer;
      padding: 2px 6px 2px 4px;
      border-radius: 4px;
      margin-left: 2px;
      font-family: inherit;
      transition: background 0.1s;
    }
    .branch-toggle:hover { background: var(--surface3); }
    .branch-toggle-icon {
      font-size: 0.6rem;
      color: var(--muted);
      transition: transform 0.18s;
      line-height: 1;
    }
    .branch-toggle.is-open .branch-toggle-icon { transform: rotate(90deg); }

    /* ── 起き攻めトグルボタン ── */
    .okizeme-toggle {
      display: inline-flex;
      align-items: center;
      gap: 3px;
      background: transparent;
      border: 1px solid var(--border-strong);
      border-radius: 3px;
      padding: 0 5px;
      cursor: pointer;
      font-size: 0.65rem;
      color: var(--muted);
      font-family: inherit;
      line-height: 1.6;
      margin-left: 4px;
      transition: background 0.1s, color 0.1s, border-color 0.1s;
      vertical-align: middle;
    }
    .okizeme-toggle:hover { background: var(--surface3); color: var(--text); border-color: var(--muted); }
    .okizeme-toggle.is-open {
      background: var(--accent-soft);
      color: var(--text);
      border-color: #f59e0b;
    }

    /* ── 起き攻めパネル ── */
    .okizeme-panel-cell {
      padding: 0 !important;
      background: var(--surface2) !important;
      border-top: none !important;
      border-bottom: 1px solid var(--border) !important;
    }
    .okizeme-panel { padding: 10px 16px 12px 24px; }
    .okizeme-panel-hd {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 8px;
    }
    .okizeme-panel-count {
      font-size: 0.72rem;
      font-weight: 700;
      color: var(--muted-strong);
      letter-spacing: 0.04em;
    }
    .okizeme-panel-ender {
      font-size: 0.7rem;
      color: var(--muted);
      background: var(--surface3);
      padding: 1px 7px;
      border-radius: 3px;
    }
    .okizeme-cards { display: flex; flex-direction: column; gap: 6px; }
    .okizeme-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 8px 10px;
    }
    .okizeme-card-hd {
      display: flex;
      align-items: baseline;
      gap: 6px;
      margin-bottom: 4px;
    }
    .okizeme-card-title { font-size: 0.8rem; font-weight: 700; color: var(--text); }
    .okizeme-card-flags { display: flex; gap: 3px; flex-wrap: wrap; }
    .okizeme-flag {
      font-size: 0.62rem;
      padding: 1px 5px;
      border-radius: 3px;
      background: var(--surface3);
      color: var(--muted-strong);
      font-weight: 600;
    }
    .okizeme-flag-safe { background: #d97706/20; color: #f59e0b; }
    .okizeme-card-inputs { margin-bottom: 4px; }
    .okizeme-card-wk { font-size: 0.7rem; color: var(--muted); line-height: 1.6; }
    .wk-label {
      display: inline-block;
      font-size: 0.62rem;
      font-weight: 700;
      color: var(--muted-strong);
      background: var(--surface3);
      padding: 0 4px;
      border-radius: 2px;
      margin-right: 4px;
    }
  </style>

  <script>
    // ── 分岐ツリー 折り畳みトグル ──
    document.querySelectorAll<HTMLButtonElement>('.branch-toggle').forEach(btn => {
      btn.addEventListener('click', () => {
        const comboId = btn.dataset.comboId;
        const isOpen = btn.classList.toggle('is-open');
        document.querySelectorAll<HTMLElement>(`tr[data-branch-of="${comboId}"]`).forEach(row => {
          row.style.display = isOpen ? '' : 'none';
        });
        if (!isOpen) {
          document.querySelectorAll<HTMLElement>(`[data-okizeme-branch-of="${comboId}"]`).forEach(panel => {
            panel.style.display = 'none';
            const panelId = panel.dataset.okizemePanel;
            if (panelId) {
              document.querySelector<HTMLElement>(`[data-okizeme-toggle="${panelId}"]`)?.classList.remove('is-open');
            }
          });
        }
      });
    });

    // ── 起き攻め展開トグル ──
    document.querySelectorAll<HTMLButtonElement>('.okizeme-toggle').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const leafId = btn.dataset.okizemeToggle;
        const isOpen = btn.classList.toggle('is-open');
        const panel = document.querySelector<HTMLElement>(`[data-okizeme-panel="${leafId}"]`);
        if (panel) panel.style.display = isOpen ? '' : 'none';
      });
    });

    // ── fork ボタン（モック: アラート） ──
    document.querySelectorAll<HTMLButtonElement>('.btn-fork').forEach(btn => {
      btn.addEventListener('click', () => {
        const comboId = btn.dataset.comboId ?? '';
        alert(`fork: ${comboId}\n\n（Phase 2 で実装予定。自分用ページにコピーされます）`);
      });
    });

    // ── 大分類 / 小分類 フィルタ ──
    const filters = { major: '', minor: '' };
    function applyFilters() {
      document.querySelectorAll<HTMLElement>('tbody.combo-group').forEach(grp => {
        const okMajor = !filters.major || grp.dataset.major === filters.major;
        const okMinor = !filters.minor || grp.dataset.minor === filters.minor;
        grp.style.display = (okMajor && okMinor) ? '' : 'none';
      });
      document.querySelectorAll<HTMLElement>('tbody.combo-section-head').forEach(head => {
        const hMajor = head.dataset.headMajor ?? '';
        const hMinor = head.dataset.headMinor ?? '';
        const hasVisible = Array.from(
          document.querySelectorAll<HTMLElement>('tbody.combo-group')
        ).some(grp => grp.style.display !== 'none' && grp.dataset.major === hMajor && grp.dataset.minor === hMinor);
        head.style.display = hasVisible ? '' : 'none';
      });
      document.querySelectorAll<HTMLElement>('tbody.combo-major-head').forEach(head => {
        const hMajor = head.dataset.headMajor ?? '';
        const hasVisible = Array.from(
          document.querySelectorAll<HTMLElement>('tbody.combo-group')
        ).some(grp => grp.style.display !== 'none' && grp.dataset.major === hMajor);
        head.style.display = hasVisible ? '' : 'none';
      });
    }

    const majorSel = document.getElementById('filter-major') as HTMLSelectElement | null;
    const minorSel = document.getElementById('filter-minor') as HTMLSelectElement | null;
    if (majorSel && minorSel) {
      majorSel.addEventListener('change', () => {
        filters.major = majorSel.value;
        Array.from(minorSel.options).forEach(opt => {
          if (!opt.value) return;
          opt.hidden = !!filters.major && opt.dataset.major !== filters.major;
        });
        const cur = Array.from(minorSel.options).find(o => o.value === minorSel.value);
        if (cur?.hidden) { minorSel.value = ''; filters.minor = ''; }
        applyFilters();
      });
      minorSel.addEventListener('change', () => {
        filters.minor = minorSel.value;
        applyFilters();
      });
    }

    // ── ソートトグル ──
    let sortOrder: 'score' | 'damage' | 'new' = 'score';

    function sortCombos() {
      document.querySelectorAll<HTMLElement>('tbody.combo-section-head').forEach(head => {
        const major = head.dataset.headMajor ?? '';
        const minor = head.dataset.headMinor ?? '';
        const groups = Array.from(document.querySelectorAll<HTMLElement>(
          `tbody.combo-group[data-major="${CSS.escape(major)}"][data-minor="${CSS.escape(minor)}"]`
        ));
        groups.sort((a, b) => {
          if (sortOrder === 'damage') return Number(b.dataset.sortDamage) - Number(a.dataset.sortDamage);
          if (sortOrder === 'new')    return Number(a.dataset.sortOrder)  - Number(b.dataset.sortOrder);
          /* score */                 return Number(b.dataset.sortScore)  - Number(a.dataset.sortScore);
        });
        // セクションヘッダの直後に並び替えた順で再挿入
        let anchor: Element = head;
        groups.forEach(g => { anchor.after(g); anchor = g; });
      });
      applyFilters();
    }

    document.querySelectorAll<HTMLButtonElement>('.sort-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.sort-btn').forEach(b => b.classList.remove('sort-btn-active'));
        btn.classList.add('sort-btn-active');
        sortOrder = (btn.dataset.sort as typeof sortOrder) ?? 'score';
        sortCombos();
      });
    });

    // 初期ソート（スコア順）
    sortCombos();
  </script>
</Layout>
