---
// コマンド表記をチップ列で表示
// inputs:  "DR > 5HP > 2MK > 214MK" のような ">" 区切り文字列
// ghostInputs: (任意) inputs の前にゴースト(薄表示)で並べる共通プレフィックス
//              一覧の分岐子行などで「枝の位置に視覚的に揃える」用途
interface Props {
  inputs: string;
  ghostInputs?: string;
  /** 分岐エルボ記号。最終子なら "└─›", 中間子なら "├─›" 等 */
  branchElbow?: string;
  size?: 'normal' | 'sm';
}
const { inputs, ghostInputs, branchElbow = '└─›', size = 'normal' } = Astro.props;
const tokens = inputs.split('>').map(t => t.trim()).filter(Boolean);
const ghostTokens = (ghostInputs ?? '').split('>').map(t => t.trim()).filter(Boolean);

// DR / DI / CA / OD / (CH) は特別チップ扱い（黒背景）
const isSpecial = (t: string) => /^(DR|DI|CA|OD)\b/i.test(t) || /\(CH\)$/i.test(t);

// 技強度判定: 末尾の LP/LK=l, MP/MK=m, HP/HK=h, PP/KK=od
// SA(236236K, 214214P 等の単独 K/P 終端) は強度なし → 既定スタイル
function moveStrength(tok: string): 'l' | 'm' | 'h' | 'od' | null {
  if (/(PP|KK)$/.test(tok)) return 'od';
  if (/(LP|LK)$/.test(tok)) return 'l';
  if (/(MP|MK)$/.test(tok)) return 'm';
  if (/(HP|HK)$/.test(tok)) return 'h';
  return null;
}
function chipClass(tok: string, ghost = false): string {
  const cls = ['cmd-chip'];
  if (ghost) cls.push('cmd-ghost');
  if (isSpecial(tok)) cls.push('cmd-chip-special');
  else {
    const s = moveStrength(tok);
    if (s) cls.push(`cmd-chip-${s}`);
  }
  return cls.join(' ');
}
---
<span class={`notation${size === 'sm' ? ' notation-sm' : ''}`}>
  {ghostTokens.map((tok, i) => (
    <>
      {i > 0 && <span class="cmd-sep cmd-ghost">›</span>}
      <span class={chipClass(tok, true)} data-token={tok}>{tok}</span>
    </>
  ))}
  {ghostTokens.length > 0 && tokens.length > 0 && <span class="cmd-sep cmd-branch-elbow">{branchElbow}</span>}
  {tokens.map((tok, i) => (
    <>
      {i > 0 && <span class="cmd-sep">›</span>}
      <span class={chipClass(tok)} data-token={tok}>{tok}</span>
    </>
  ))}
</span>

<style is:global>
  .cmd-ghost { opacity: 0.32; }
  .cmd-branch-elbow {
    color: var(--muted) !important;
    font-family: 'JetBrains Mono', monospace !important;
    font-size: 0.9rem !important;
    font-weight: 600 !important;
  }

  /* ── 技強度カラー（パレットと統一） ── */
  .cmd-chip.cmd-chip-l  { background:#dbeafe; border-color:#60a5fa; color:#1e3a8a; }
  .cmd-chip.cmd-chip-m  { background:#fef3c7; border-color:#eab308; color:#854d0e; }
  .cmd-chip.cmd-chip-h  { background:#fee2e2; border-color:#ef4444; color:#991b1b; }
  .cmd-chip.cmd-chip-od {
    background: linear-gradient(135deg,#fde047 0%,#f59e0b 100%);
    border-color: #b45309;
    color: #451a03;
  }
</style>
