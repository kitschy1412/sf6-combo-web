---
// 表記の切り替えボタン。設定は localStorage に保存し、ページへの反映は Layout.astro が行う
// （技名の変換テーブルは Layout の character で決まる）
---

<div id="notation-toggle-bar" style="display:flex; gap:16px; align-items:center; flex-wrap:wrap; padding:10px 0; margin-bottom:16px;">

  <!-- 方向入力トグル -->
  <div style="display:flex; align-items:center; gap:6px;">
    <span class="ntoggle-label">方向</span>
    <button class="ntoggle-btn" data-group="dir" data-value="numpad">数字</button>
    <button class="ntoggle-btn" data-group="dir" data-value="arrows">矢印</button>
  </div>

  <!-- 必殺技名トグル -->
  <div style="display:flex; align-items:center; gap:6px;">
    <span class="ntoggle-label">必殺技</span>
    <button class="ntoggle-btn" data-group="name" data-value="command">コマンド</button>
    <button class="ntoggle-btn" data-group="name" data-value="name">技名</button>
  </div>

</div>

<script>
  import { readNotationPrefs, NOTATION_CHANGE_EVENT, NOTATION_STORAGE_KEYS } from '../lib/notation';

  // data-group を持つボタンだけが対象（ComboEditor 内の同じ見た目のトグルは data-editor-toggle で別扱い）
  const buttons = document.querySelectorAll<HTMLButtonElement>('.ntoggle-btn[data-group]');

  // ボタンの選択状態を保存済みの設定に合わせる
  function syncButtons(): void {
    const prefs = readNotationPrefs(localStorage);
    buttons.forEach((btn) => {
      const current = btn.dataset.group === 'dir' ? prefs.dir : prefs.name;
      btn.classList.toggle('ntoggle-active', btn.dataset.value === current);
    });
  }

  // ── トグルクリック: 保存して全体に知らせる ──────────────────
  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const key = btn.dataset.group === 'dir' ? NOTATION_STORAGE_KEYS.dir : NOTATION_STORAGE_KEYS.name;
      localStorage.setItem(key, btn.dataset.value ?? '');
      document.dispatchEvent(new CustomEvent(NOTATION_CHANGE_EVENT));
    });
  });

  document.addEventListener(NOTATION_CHANGE_EVENT, syncButtons);
  syncButtons();
</script>
